# Database
POSTGRES_DB=bugboard
POSTGRES_USER=bugboard
POSTGRES_PASSWORD=bugboard_password

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1
DEV_EXTRA_CSRF_ORIGINS=

# Email provider
EMAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_OTP_TEMPLATE_ID=
BREVO_NEW_USER_TEMPLATE_ID=
BREVO_SENDER_NAME=BugBoard26
DEFAULT_FROM_EMAIL=noreply@bugboard26.local

# Session
SESSION_COOKIE_AGE_SECONDS=28800
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Frontend API base
VITE_API_BASE_URL=/api
